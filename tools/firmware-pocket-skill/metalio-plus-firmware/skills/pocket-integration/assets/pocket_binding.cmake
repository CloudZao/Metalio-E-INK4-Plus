# Attach the small Plus public protocol core to an existing IDF component.
# The caller supplies a generated C descriptor and its own platform/business glue.
function(plus_attach_pocket component_target core_dir descriptor_c)
    if(NOT TARGET "${component_target}")
        message(FATAL_ERROR "plus_attach_pocket requires an existing IDF component target")
    endif()
    foreach(source pocket_core.cc pocket_handoff.cc pocket_image.cc)
        if(NOT EXISTS "${core_dir}/${source}")
            message(FATAL_ERROR "Missing Plus pocket core: ${core_dir}/${source}")
        endif()
        target_sources(${component_target} PRIVATE "${core_dir}/${source}")
    endforeach()
    if(NOT EXISTS "${descriptor_c}")
        message(FATAL_ERROR "Generate the application's pocket metadata C source first")
    endif()
    target_sources(${component_target} PRIVATE "${descriptor_c}")
    target_include_directories(${component_target} PUBLIC "${core_dir}")
    target_link_libraries(${component_target} INTERFACE "-u pocket_compact_metadata")
endfunction()
